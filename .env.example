# Copy to .env and fill in from the Team 91 access email. NEVER commit .env.
#
#   cp .env.example .env      # then paste the real values into .env
#
# .env, .env.*, secrets.toml and .streamlit/secrets.toml are all gitignored,
# and .githooks/pre-commit blocks a credential-shaped value from being staged
# under any filename. Install the hook once per clone:
#
#   git config core.hooksPath .githooks
#
# These names are the ones the code actually reads -- verified against
# build_d5_orchestrator.py, build_d1_audience_profiles.py and
# skills/env-verify/scripts/verify_environment.py. Renaming one silently
# disables the feature that reads it, with no error.

AZURE_OPENAI_API_KEY=<key 1 from the Team 91 access email>
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21

# The mini deployment. Read by build_d5_orchestrator._llm_client() as the
# fallback when _DEPLOYMENT_MINI is unset, and by verify_environment.py.
AZURE_OPENAI_DEPLOYMENT=<mini deployment name>

# Tiered deployments. _MINI is what D5's explain() prefers for the one
# rep-facing narrative per plan.
AZURE_OPENAI_DEPLOYMENT_MINI=<mini deployment name>

# NOTHING IN THE REPO READS THESE TWO YET, which is a real gap and not a
# formatting detail: with only mini wired, every call bills at mini rates on a
# $5 shared budget. Nano is roughly 3.7x cheaper per token and is the right
# tier for brief parsing, archetype labelling and feedback-intent
# classification -- i.e. everything except the final narrative.
AZURE_OPENAI_DEPLOYMENT_NANO=<nano deployment name>
AZURE_OPENAI_DEPLOYMENT_EMBED=text-embedding-3-small

# --------------------------------------------------------------------------- #
# Cost ceiling. $5 total, shared across all four of us, no extensions.
# 500 requests/min is also shared, so a 429 is a teammate, not a bug.
# --------------------------------------------------------------------------- #
LLM_MAX_CALLS=40

# D6 (Streamlit) only. Leave at 0 until the [WIRE n] points in adapters.py are
# connected -- the app runs on stub data at 0 and the topbar says "stub data",
# which is what makes an unwired demo obvious instead of plausible.
D6_REAL=0
